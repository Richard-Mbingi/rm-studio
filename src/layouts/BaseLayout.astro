---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  /**
   * Case-study pages (Figma "Project details" layout) supply their own
   * full-width nav/footer chrome instead of the shared narrow `.wrap` +
   * wordmark header used by the rest of the site.
   */
  fullBleed?: boolean;
}
const { title, fullBleed = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;700;900&family=Playfair+Display:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <style is:global>
      :root {
        --bg: #fafaf8;
        --ink: #16171a;
        --ink-soft: #6e7079;
        --line: #e4e3de;
        --accent: #3454d1;
        --accent-soft: #eef1fc;
        --card-bg: #f3f4f6;
        --card-bg-hover: #e5e7eb;
        --border-default: #e5e7eb;
        --border-strong: #d1d5db;
        --border-placeholder: #c9c9c3;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        background: var(--bg);
        color: var(--ink);
        font-family: 'Archivo', sans-serif;
        font-weight: 400;
        -webkit-font-smoothing: antialiased;
      }
      .wrap {
        max-width: 720px;
        margin: 0 auto;
        padding: 64px 24px 120px;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      header .name {
        font-weight: 900;
        font-size: 22px;
        letter-spacing: -0.01em;
      }
      header .tag {
        color: var(--ink-soft);
        font-size: 15px;
        margin-top: 6px;
      }
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 280ms;
      }
    </style>
  </head>
  <body>
    {
      fullBleed ? (
        <slot />
      ) : (
        <div class="wrap">
          <header>
            <a href="/">
              <div class="name" transition:name="site-logo">RM Studio</div>
              <div class="tag">Product &amp; UI design</div>
            </a>
          </header>
          <slot />
        </div>
      )
    }
  </body>
</html>
