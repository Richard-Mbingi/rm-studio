---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = (await getCollection('work')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
---

<BaseLayout title="RM Studio — Selected work">
  <main class="home">
    <h1 class="sr-only">Selected work</h1>
    <div class="grid">
      {
        entries.map((entry) => (
          <a class="card" href={`/work/${entry.id}/`}>
            <span class="sr-only">{entry.data.title}</span>
          </a>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  .home {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 220px);
  }
  .grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 24px;
  }
  .card {
    display: block;
    width: 160px;
    aspect-ratio: 210 / 297;
    background: var(--card-bg);
    transition: background 0.15s ease;
  }
  .card:hover,
  .card:focus-visible {
    background: var(--card-bg-hover);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
