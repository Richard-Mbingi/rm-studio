---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = (await getCollection('work')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
---

<BaseLayout title="Richie — Selected work">
  <main>
    <h1 class="section-title">Selected work</h1>
    <div class="row-list">
      {
        entries.map((entry) => (
          <a class="row" href={`/work/${entry.id}/`}>
            <span class="row-title" transition:name={`title-${entry.id}`}>
              {entry.data.title}
            </span>
            <span class="row-meta">{entry.data.tags.join(' · ')}</span>
          </a>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  .section-title {
    font-weight: 700;
    font-size: 17px;
    margin-bottom: 8px;
  }
  .row-list {
    margin-top: 48px;
  }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    border-top: 1px solid var(--line);
    padding: 26px 0;
  }
  .row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .row-title {
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }
  .row-meta {
    color: var(--ink-soft);
    font-size: 14px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .row:hover .row-title,
  .row:focus-visible .row-title {
    color: var(--accent);
  }
</style>
